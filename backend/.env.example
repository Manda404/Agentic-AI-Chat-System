# Application Settings
APP_NAME=Agentic RAG Platform Backend
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Provider Configuration
LLM_PROVIDER=huggingface

# Hugging Face API (Replace with your key)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# One generation model (provider availability must be checked for your account)
HUGGINGFACE_MODEL=Qwen/Qwen3-4B-Instruct-2507
# Optional capability overrides: MODEL_SUMMARIZATION, MODEL_QUESTION_ANSWERING.
# Embeddings still use HuggingFace, even when generation uses Ollama.

# Semantic reranker (embeddings via HuggingFace Router)
MODEL_EMBEDDING=BAAI/bge-small-en-v1.5
SEMANTIC_RERANKER_ENABLED=true

# Redis Configuration
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_TTL_SECONDS=3600

# MongoDB Atlas Configuration (text retrieval through Atlas Search + vectors through Atlas Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agentic_rag
MONGODB_COLLECTION=documents
MONGODB_SEARCH_INDEX=documents_search
MONGODB_VECTOR_INDEX=documents_vector
# Embedding model dimension (MODEL_EMBEDDING): 384 for BAAI/bge-small-en-v1.5.
EMBEDDING_DIMENSIONS=384

# Document access and ingestion guardrails
# Local default is shared; non-local environments default to owner unless overridden.
DOCUMENT_SCOPE_MODE=shared
DOCUMENT_DEFAULT_VISIBILITY=shared
BATCH_INGEST_ROOT=data
MAX_UPLOAD_BYTES=10485760
MAX_BATCH_FILES=20
MAX_INGEST_DOCUMENTS=500
MAX_INGESTED_SNIPPET_CHARS=5000
ADMIN_EMAILS=
RESET_REQUIRES_ADMIN=false
BATCH_INGEST_REQUIRES_ADMIN=false

# Langfuse Observability (Replace with your keys)
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENV=production
LANGFUSE_USER_ID=user-dev

# Production guardrails
MAX_USER_MESSAGE_CHARS=8000
MAX_RAG_CONTEXT_CHARS=4000
MAX_RAG_DOCUMENTS=5
RATE_LIMIT_REQUESTS_PER_MINUTE=60
CITATION_SUPPORT_REQUIRED=false
CITATION_SUPPORT_MIN_OVERLAP=1
LLM_TIMEOUT_SECONDS=60
# Total budget of the documentary agent (LLM and tool waits included)
DOCUMENTARY_AGENT_TIMEOUT_SECONDS=90

# Authentication
AUTH_SECRET_KEY=change-me-in-real-projects-use-long-random-string
AUTH_ALGORITHM=HS256
AUTH_TOKEN_EXPIRY_MINUTES=120

# Logging (see app/logger.py)
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=multi-agent-backend.log
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FORMAT_JSON=false
LOG_ROTATION=10 MB
LOG_RETENTION=3

# Optional web search for auto mode; Hugging Face remains the LLM provider.
TAVILY_API_KEY=
